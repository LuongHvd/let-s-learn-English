rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidProgress(data, userId) {
      return data.keys().hasAll(['userId', 'learnedWordIds', 'favoriteWordIds', 'completedDialogueIds', 'streak', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'learnedWordIds', 'favoriteWordIds', 'completedDialogueIds', 'streak', 'totalReviewCount', 'lastStudyDate', 'dailyStats', 'updatedAt']) &&
             data.userId == userId &&
             data.learnedWordIds is list && data.learnedWordIds.size() <= 500 &&
             data.favoriteWordIds is list && data.favoriteWordIds.size() <= 500 &&
             data.completedDialogueIds is list && data.completedDialogueIds.size() <= 100 &&
             data.streak is number && data.streak >= 0 &&
             (!('totalReviewCount' in data) || (data.totalReviewCount is number && data.totalReviewCount >= 0)) &&
             (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 10)) &&
             (!('dailyStats' in data) || (data.dailyStats is map)) &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if false;

      match /progress/{progressDoc} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProgress(incoming(), userId);
        allow update: if isOwner(userId) && isValidProgress(incoming(), userId) &&
                      incoming().userId == existing().userId;
        allow delete: if false;
      }
    }
  }
}
